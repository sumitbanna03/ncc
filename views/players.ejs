 <% layout("/layouts/boilerplate.ejs") %>
 <% block('title').append('Players') %>
 <% block('style').append('css/players.css') %>
  <%- block('desktopSearch').append(' <div class="desktop-search"<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input type="text" placeholder="Search…" id="dSearch" class="searchInput"/></div>') %>
 <% block('mobileSearch').append(' <div class="mobile-search"> <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>  <input type="text" placeholder="Search…" id="mSearch" class="searchInput"/> </div>' )%>
 <% block('playersActive').append('active') %>
 
<body>
    
<h2 style="height: 80px; text-align: center; line-height: 100px; background-color: #db6f02; color: #F8FAFC; " >All NCC players:</h2>
<div class="players" id="result">
  <% 
    for(player of players){ %>
       <%player.name = player.name.slice(0, -1);%>
    <div class="card player" >
      <div class="player-img-box"> 
         <img src="<%= player.img.url %>" class="player-img" alt="Player image">
         <% if(player.role == "Batter"){ %>
         <img src="images/cricket-bat.png"  class="role-icon" ></img>
         <% } else if(player.role == "Bowler"){%>
           <img src="images/cricket-ball.png" style="padding: 5px;" class="role-icon"></img>
          <% }else if(player.role == "Wicket-Keeper"){%>
           <img src="images/keeper.png"  class="role-icon"></img>
          <% } else{%>
            <img src="images/cricket.png"  class="role-icon"></img>

            <% } %>
          
         </div>
  <div class="card-body">
    <h5 class="card-title"><%= player.name %></h5>
    <p class="card-text">Batting: <%= player.batting %><br>
      Bowling: <%= player.bowling %> <br>
      Age: <%= player.age %>  </p>
   <form action="/players/profile/<%= player._id %>"><button  class="btn ">View Profile</button></form> 
  </div>
</div>
  <% }; %>
</div><br>
 <% if(currUser && currUser.isAdmin){%>
  <a href="/players/new"  >
   <button  class="btn add ms-2 mb-2"> Add new player</button>
  </a> <br>
  <a href="/players/delete" >
  <button  class="btn add ms-2" > Delete player</button>
  </a>
  <% } %> 

<script src="/js/players.js">  </script>
</body>

 
 
 