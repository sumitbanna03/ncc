<% layout("/layouts/boilerplate.ejs") %>
<% block('title').append('Edit-Profile') %>

<div class="container mt-4">
    <!-- Changed type to password for current password for security -->
    <form action="/profile/edit-password/<%= player.id %>?_method=PATCH" method="POST" novalidate class="row g-3 needs-validation" id="form">
        <h2>Change password:</h2>
        
        <div class="col-12">
            <label for="currPassword" class="form-label">Enter current password:</label>
            <input type="password" class="form-control" required id="currPassword" name="currPassword">
            <div class="invalid-feedback">Please enter your current password.</div>
        </div>

        <div class="col-12">
            <label for="newPassword" class="form-label">Enter New password:</label>
            <input type="password" class="form-control" required id="newPassword" name="newPassword">
        </div>

        <div class="col-12">
            <label for="confirmPassword" class="form-label">Confirm New password:</label>
            <input type="password" class="form-control" required id="confirmPassword">
            <!-- Used Bootstrap classes for the error message -->
            <div class="text-danger d-none" id="missMatch">Passwords did not match</div>
        </div>

        <div class="col-12">
            <button class="btn" style="width: 200px; border-radius: 5px; background-color: #12203e; color:white;" type="submit">Save</button>
        </div>
    </form>
</div>

<script>
    const form = document.getElementById('form');
    const newPass = document.getElementById('newPassword');
    const confirmPass = document.getElementById('confirmPassword');
    const missMatch = document.getElementById('missMatch');

    form.addEventListener('submit', event => {
        // 1. Check Bootstrap basic validation (required fields)
        if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
        }

        // 2. Check Password Match
        if (newPass.value !== confirmPass.value) {
            event.preventDefault();
            event.stopPropagation();
            missMatch.classList.remove('d-none'); // Show error
            missMatch.classList.add('d-block');
        } else {
            missMatch.classList.add('d-none'); // Hide error
            missMatch.classList.remove('d-block');
        }

        form.classList.add('was-validated');
    }, false);

    // Real-time feedback as user types
    confirmPass.addEventListener('input', function() {
        if (newPass.value === confirmPass.value) {
            missMatch.classList.replace('d-block', 'd-none');
        } else {
            missMatch.classList.replace('d-none', 'd-block');
        }
    });
</script>