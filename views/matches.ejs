<% layout("/layouts/boilerplate.ejs") %>
 <% block('title').append('Matches') %>

 <% block('style').append('/css/matches.css') %>
 <% block('desktopSearch').append('  <div class="desktop-search"<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input type="text" class="searchInput" data-has-user="' + !!currUser + '" placeholder="Search…"/></div>') %>
 <% block('mobileSearch').append(' <div class="mobile-search"> <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>  <input type="text" class="searchInput" data-has-user="' + !!currUser + '" placeholder="Search…"/> </div>' )%>
  <% block('script').append('<script src="js/matches.js"></script>') %>
  <% block('matchesActive').append('active') %>
<body>

<header class="page-header">
  <p class="eyebrow">Nihalwadi Cricket Club</p>
  <h1>All NCC Matches</h1>
  <div class="underline-bar"></div>
</header>

<div class="match-list" id="results">
<% if(matches.length == 0){%>
    <p>there are no matches yet!</p>
  <%}%>
   <% for(match of matches){ %>
            <%match.t1Name = match.t1Name.slice(0, -1);%>
            <% match.t2Name = match.t2Name.slice(0, -1);%>
    <div class="main-card">
  <div class="card">
    <div class="card-top">
      <span class="match-date">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
       <%=match.date %>
      </span>
      <span class="match-status status-completed">Completed</span>
    </div>
    <div class="scoreboard">
      <div class="team home">
        <span class="team-name <% if(match.t1Runs>match.t2Runs) {%>winner<% } %>"><%=match.t1Name %></span>
        <span class="score <% if(match.t1Runs>match.t2Runs) {%>winner<% } %>"><%=match.t1Runs %>/<%=match.t1Wickets %></span>
        <span class="overs">(<%=match.t1Overs %>)</span>
      </div>
      <div class="vs-badge">VS</div>
      <div class="team away">
        <span class="team-name <% if(match.t1Runs<match.t2Runs) {%>winner<% } %>"><%=match.t2Name %></span>
        <span class="score <% if(match.t1Runs<match.t2Runs) {%>winner<% } %>"><%=match.t2Runs %>/<%=match.t2Wickets %></span>
        <span class="overs">(<%=match.t2Overs %>)</span>
      </div>
    </div>
    <div class="result-strip <% if((match.t1Runs>match.t2Runs && (match.t2Name == "Nihalwadi "|| match.t2Name == "Nihalwadi"))||(match.t1Runs<match.t2Runs && (match.t1Name == "Nihalwadi " || match.t1Name == "Nihalwadi"))){ %> loss<% } %>"> <% if(match.t1Runs>match.t2Runs) {%>
        <%=match.t1Name  %> won by <%=match.t1Runs - match.t2Runs%> runs
        <% } else if(match.t1Runs<match.t2Runs){ %>
            <%=match.t2Name %> won by <%= 10 - match.t2Wickets %> wickets
          <%}else{ %>
            Match tied
            <%}%> </div>
    <div class="card-footer">
      <div class="potm">
        <div class="potm-icon">⭐</div>
        <div>
          <div class="potm-label">Player of the Match</div>
          <div class="potm-name"><% if(match.motm){ %><%=match.motm %><% }else{ %>NA<% } %> </div>
        </div>
      </div>
       <% if(currUser && currUser.isAdmin){ %>
      <form action="/matches/<%= match._id %>?_method=DELETE" 
        method="POST"
        onsubmit="return confirm('You want to delete this match?');"
        >
     <button class="view-btn"> Delete </button> 
      </form>
      <%}  %>
      <!-- <a href="#" class="view-btn">Details →</a> -->
    </div>
  </div>
<% }; %>
</div><br>
<% if(currUser && currUser.isAdmin){ %>
    <form action="/matches/new" method="get">
   &nbsp;&nbsp;<button class="btn ">Add new Match</button>
  </form>
    <%}  %>
</body>
