
 <% layout("/layouts/boilerplate.ejs") %>
  <% block('title').append('Home') %>

 <% block('style').append('css/home.css') %>
 <% block('homeActive').append('active') %>

<body>

<main>
 <div class="upper-main">
   <div class="ground">
  <p>Welcome to <br>
    &nbsp;&nbsp;Nihalwdi Cricket Club</p>
 <div class="stats-container">
  <a href="/matches"><div class="stats" id="stat1">  <i class="fa-solid fa-drum-steelpan"></i>matches 
    <br><%= mCount %> </div></a>
  <a href="/players"><div class="stats" id="stat2"><i class="fa-solid fa-user"></i> players
    <br><%= pCount %> </div></a>
  <div class="stats" id="stat3"><i class="fa-solid fa-trophy"></i> trophies 
    <br> 00</div>
 </div>
 </div>
 <span class="nccLine">Nihalwadi Cricket Club is a passionate and growing cricket team known for its strong teamwork and sportsmanship. The club actively participates in local tournaments and promotes young talent. With dedication and regular practice, players continue to improve their skills and performance. The team maintains a competitive spirit while respecting the values of the game. Nihalwadi Cricket Club is becoming a proud name in the local cricket community.
</span>
 </div>
 <div class="tournaments">
  <h2>&nbsp;Tournaments Memories:</h2><br>
 
  <div id="carouselTwo" class="carousel slide tournament" >
    &nbsp;<span class="heading">1. Songir - 2<sup>nd</sup> Prize</span>
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#carouselTwo" data-bs-slide-to="0" class="active"></button>
    <button type="button" data-bs-target="#carouselTwo" data-bs-slide-to="1"></button>
    <button type="button" data-bs-target="#carouselTwo" data-bs-slide-to="2"></button>
    <button type="button" data-bs-target="#carouselTwo" data-bs-slide-to="3"></button>
  </div>

  <div class="carousel-inner tournament-img">
    <div class="carousel-item active">
      <img src="https://res.cloudinary.com/drupkujzt/image/upload/v1778128597/nccT01_fiepgj.jpg" class="d-block w-100">
    </div>
    <div class="carousel-item">
      <img src="https://res.cloudinary.com/drupkujzt/image/upload/v1778128595/nccT02_nudrid.jpg" class="d-block w-100">
    </div>
    <div class="carousel-item">
      <img src="https://res.cloudinary.com/drupkujzt/image/upload/v1778128598/nccT04_u4x694.jpg" class="d-block w-100">
    </div>
    <div class="carousel-item">
      <img src="https://res.cloudinary.com/drupkujzt/image/upload/v1778128596/nccT03_kayxhy.jpg" class="d-block w-100">
    </div>
  </div>

  <button class="carousel-control-prev" type="button" data-bs-target="#carouselTwo" data-bs-slide="prev"><i class="fa-solid fa-chevron-left"></i></button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselTwo" data-bs-slide="next"><i class="fa-solid fa-chevron-right"></i></button>
 </div>

 <div id="carouselOne" class="carousel slide tournament" >
    &nbsp;<span class="heading">2. Mitawal - 1<sup>st</sup> Prize</span>

  <div class="carousel-indicators">
    <button type="button" data-bs-target="#carouselOne" data-bs-slide-to="0" class="active"></button>
    <button type="button" data-bs-target="#carouselOne" data-bs-slide-to="1"></button>
    <button type="button" data-bs-target="#carouselOne" data-bs-slide-to="2"></button>
  </div>

  <div class="carousel-inner tournament-img">
    <div class="carousel-item active">
      <img src="https://res.cloudinary.com/drupkujzt/image/upload/v1778128593/nccmitaval01_lq0exr.jpg" class="d-block w-100">
    </div>
    <div class="carousel-item">
      <img src="https://res.cloudinary.com/drupkujzt/image/upload/v1778128595/nccT02_nudrid.jpg" class="d-block w-100">
    </div>
     <div class="carousel-item">
      <img src="https://res.cloudinary.com/drupkujzt/image/upload/v1778128594/nccmitaval03_oidcl7.jpg" class="d-block w-100">
    </div>
  </div>

  <button class="carousel-control-prev" type="button" data-bs-target="#carouselOne" data-bs-slide="prev"><i class="fa-solid fa-chevron-left"></i></button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselOne" data-bs-slide="next"><i class="fa-solid fa-chevron-right"></i></button>
 </div>
  </div>
 </main>
 </body>
 